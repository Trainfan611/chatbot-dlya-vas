# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ВКонтакте токен сообщества (получить в управлении сообществом)
VK_TOKEN=your_vk_token_here

# OpenAI API Key (ОСНОВНОЙ)
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (резерв - Китай, бесплатно)
# Получить: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq API Key (резерв - работает из РФ)
# Получить: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GigaChat API Key (Сбер, резерв)
# Получить: https://developers.sber.ru/docs/ru/gigachat/api/reference/credentials
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here

# GigaChat OAuth данные
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
